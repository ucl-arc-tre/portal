{
  "name": "ucl-arc-tre-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "openapi-ts": "openapi-ts --client @hey-api/client-fetch --input ../api/web.yaml --output ./src/openapi",
    "cypress:open": "cypress open",
    "cypress:headless": "cypress run --headless --browser chrome",
    "cypress:pages": "cypress run --headless --browser chrome --spec 'cypress/e2e/pages/**/*'",
    "cypress:integration": "cypress run --headless --browser chrome --spec 'cypress/e2e/integration/**/*'",
    "test": "node --import tsx --test",
    "test:watch": "node --import tsx --test --watch"
  },
  "dependencies": {
    "design-system-foundations-public": "^0.1.6",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "uikit-react-public": "^0.43.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^15.21.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10",
    "eslint-config-next": "^16.3.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
